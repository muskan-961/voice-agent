# Primary default provider — used whenever the page's LLM Settings panel
# is left blank (the UI's provider dropdown also defaults to OpenAI, see
# DEFAULT_PROVIDER in public/app.js). Any OpenAI-compatible endpoint works
# here, not just OpenAI itself.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# Dedicated Groq fallback credentials — used automatically when the
# primary provider above hits a rate limit (see handleTurnFailure in
# public/app.js). Kept separate from the primary default on purpose: the
# fallback needs somewhere real to switch to regardless of which provider
# is configured as primary.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

PORT=3000
